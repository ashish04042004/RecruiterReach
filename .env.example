# Copy this file to .env and fill in the values. .env is git-ignored; never commit real keys.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: default model (can also be changed on the Settings page)
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or retired
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# Google OAuth client (type "Web application") from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional overrides
# PORT=3001
# CLIENT_URL=http://localhost:5173
# DATA_DIR=./data
