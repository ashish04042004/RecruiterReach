{
  "name": "recruiterreach",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, AI-assisted recruiter outreach manager",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
